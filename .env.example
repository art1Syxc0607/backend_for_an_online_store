# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# ===== Обязательные =====
# Пароль PostgreSQL (используется и контейнером db, и API)
DB_PASSWORD=change_me_strong_password

# Ключ подписи JWT — минимум 32 символа, случайная строка
JWT_KEY=change_me_super_secret_key_at_least_32_chars

# ===== Домен / TLS =====
# Домен, на котором будет доступен магазин. Caddy выпустит TLS-сертификат.
# Для локального теста можно оставить localhost.
DOMAIN=store.example.com

# ===== PostgreSQL =====
POSTGRES_DB=WebStoreProjectDb
POSTGRES_USER=postgres

# ===== JWT (опционально) =====
JWT_ISSUER=MyAuthServer
JWT_AUDIENCE=MyAuthClient

# ===== Внешние сервисы (опционально) =====
# Ключ Groq для AI-агента: https://console.groq.com/keys
GROQ_API_KEY=
# Пароль приложения Gmail (Smtp:Password) для отправки писем
SMTP_PASSWORD=
# Ключ ipinfo.io для геолокации: https://ipinfo.io/account/token
IPINFO_API_KEY=
