{
  "App": {
    "BaseUrl": "https://localhost:7197"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=WebStoreProjectDb;Username=postgres"
  },

  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "pm44.salin@gmail.com",
    "Password": "",
    "FromEmail": "pm44.salin@gmail.com",
    "FromName": "ArtWebStore",
    "EnableSsl": true
  },

  "IpInfo": {
    "ApiKey": "",
    "BaseUrl": "https://ipinfo.io",
    "TimeoutSeconds": 5,
    "Enabled": true
  },

  "Agent": {
    "GuestConversationRetentionDays": 7,
    "CleanupIntervalHours": 6,
    "Enabled": true
  },

  "BackgroundServices": {
    "ExpiredOrders": {
      "Enabled": true,
      "PaymentTimeoutMinutes": 30,
      "CheckIntervalMinutes": 15
    }
  },

  // Файловые синки добавляются в Program.cs через WriteTo.Async,
  // поэтому здесь остаётся только консоль - иначе каждая строка
  // пишется в logs/all и logs/errors дважды.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information"
        }
      }
    ],
    "Enrich": [ "WithMachineName", "WithThreadId" ]
  },

  "Jwt": {
    "Issuer": "MyAuthServer",
    "Audience": "MyAuthClient"
  },

  // Rate limiting (.NET 8 built-in). PermitLimit <= 0 отключает политику.
  // В тестах и на нагрузочных прогонах секция переопределяется.
  "RateLimiting": {
    "Enabled": true,
    "Global": { "PermitLimit": 600, "WindowSeconds": 60 },
    "Login": { "PermitLimit": 5, "WindowSeconds": 60 },
    "Register": { "PermitLimit": 5, "WindowSeconds": 600 },
    "RequestReset": { "PermitLimit": 3, "WindowSeconds": 900 },
    "SubmitReset": { "PermitLimit": 10, "WindowSeconds": 900 },
    "ResendEmail": { "PermitLimit": 1, "WindowSeconds": 300 }
  }
}
