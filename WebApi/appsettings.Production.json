{
  // Production-переопределения. ASP.NET Core подхватывает этот файл
  // автоматически при ASPNETCORE_ENVIRONMENT=Production (Docker).
  // Основная цель - не писать SQL-лог каждого запроса в файлы.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
